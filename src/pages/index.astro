---
import Navbar from "../components/Navbar.astro";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>VibeCoding - Modern Landing Page</title>
    <meta name="description" content="Landing page modern dengan Astro.js, responsive dan dark mode." />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      (function () {
        const storedTheme = typeof localStorage !== "undefined" && localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (storedTheme === "dark" || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body>
    <!-- Navbar Component -->
    <Navbar />

    <!-- Main Content Placeholder to verify scrolling and responsiveness -->
    <main>
      <section id="beranda" class="hero-section">
        <div class="container hero-content">
          <div class="hero-pill">🚀 Modern & Responsive Landing Page</div>
          <h1 class="hero-title">
            Bangun Web Cepat & Elegan Bersama <span class="gradient-text">VibeCoding</span>
          </h1>
          <p class="hero-desc">
            Komponen Navbar modern yang responsif untuk tampilan mobile dan desktop, dilengkapi dengan Dark Mode toggle instan dan desain bersih.
          </p>
          <div class="hero-actions">
            <a href="#mulai" class="btn-hero-primary">Mulai Sekarang</a>
            <a href="#fitur" class="btn-hero-secondary">Jelajahi Fitur</a>
          </div>
        </div>
      </section>

      <section id="fitur" class="feature-section">
        <div class="container">
          <div class="section-header">
            <h2 class="section-title">Fitur Unggulan</h2>
            <p class="section-desc">Dibuat dengan standar performa dan pengalaman pengguna terbaik.</p>
          </div>
          <div class="feature-grid">
            <div class="feature-card">
              <div class="card-icon">⚡</div>
              <h3>Super Cepat</h3>
              <p>Ditenagai oleh Astro.js dengan output statis optimal dan minimal JavaScript.</p>
            </div>
            <div class="feature-card">
              <div class="card-icon">📱</div>
              <h3>100% Responsif</h3>
              <p>Tampilan fleksibel mulai dari layar smartphone, tablet, hingga monitor desktop lebar.</p>
            </div>
            <div class="feature-card">
              <div class="card-icon">🌓</div>
              <h3>Dark & Light Mode</h3>
              <p>Dukungan pergantian tema yang mulus dengan persistensi otomatis di penyimpanan lokal.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-content">
        <p>© 2026 VibeCoding. Hak cipta dilindungi undang-undang.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* CSS Variables for Light & Dark Theme */
  :root {
    --bg-primary: #ffffff;
    --bg-secondary: #f8fafc;
    --text-primary: #0f172a;
    --text-secondary: #64748b;
    --border-color: #e2e8f0;
    --border-hover: #cbd5e1;
    --nav-bg: rgba(255, 255, 255, 0.85);
    --nav-border: rgba(226, 232, 240, 0.8);
    --btn-secondary-bg: #f1f5f9;
    --btn-secondary-hover: #e2e8f0;
    --card-bg: #ffffff;
    --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
  }

  html.dark {
    --bg-primary: #0b0f19;
    --bg-secondary: #0f172a;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --border-color: #1e293b;
    --border-hover: #334155;
    --nav-bg: rgba(11, 15, 25, 0.85);
    --nav-border: rgba(30, 41, 59, 0.8);
    --btn-secondary-bg: #1e293b;
    --btn-secondary-hover: #334155;
    --card-bg: #131b2e;
    --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    scroll-behavior: smooth;
    color-scheme: light dark;
  }

  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  body.menu-open {
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Hero Section */
  .hero-section {
    padding: 6rem 0 5rem;
    text-align: center;
    background: radial-gradient(circle at 50% 20%, rgba(59, 130, 246, 0.08) 0%, transparent 60%);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
  }

  .hero-pill {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: var(--btn-secondary-bg);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .hero-desc {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .btn-hero-primary {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(135deg, #3b82f6, #6366f1);
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.35);
    transition: all 0.2s ease;
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(59, 130, 246, 0.45);
  }

  .btn-hero-secondary {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--btn-secondary-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-hero-secondary:hover {
    background: var(--btn-secondary-hover);
    border-color: var(--border-hover);
  }

  /* Feature Section */
  .feature-section {
    padding: 5rem 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    background: var(--card-bg);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-hover);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--text-secondary);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  /* Footer */
  .footer {
    margin-top: auto;
    padding: 2.5rem 0;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
</style>
